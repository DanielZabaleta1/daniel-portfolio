# VSL embed (YouTube unlisted or Vimeo URL). Leave empty until the intro video is
# recorded — the hero tile falls back to the placeholder with an inert play button.
VITE_VSL_URL=

# --- The wall (Vercel KV / Upstash Redis) ---
# Required for /api/comments to work. Created automatically when you connect
# a Vercel KV (Upstash Redis) store to the project in the Vercel dashboard —
# Vercel injects these into the deployment, no need to set them by hand there.
# Without them, GET /api/comments returns 503 and the frontend falls back to
# a local-only (per-browser) version of the wall — the build never breaks.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin token to authorize DELETE /api/comments/:id (moderation).
# Pick your own value, set it in Vercel project settings, never commit the real one.
# See README.md "Moderating the wall" for how to use it.
ADMIN_TOKEN=
