# VSL embed (YouTube unlisted or Vimeo URL). Leave empty until the intro video is
# recorded — the hero tile falls back to the placeholder with an inert play button.
VITE_VSL_URL=

# --- Phase 3: the wall (Vercel KV / Upstash Redis) ---
# Created automatically when you connect a Vercel KV store to the project;
# Vercel injects these into the deployment, no need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Admin token to authorize DELETE /api/comments/:id (moderation).
# Pick your own value, set it in Vercel project settings, never commit the real one.
# ADMIN_TOKEN=
